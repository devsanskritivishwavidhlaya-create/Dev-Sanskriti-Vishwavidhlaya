{
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).(js|css|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://rather-oecd-culture-initiative.trycloudflare.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://rather-oecd-culture-initiative.trycloudflare.com/uploads/:path*" }
  ]
}